# ============================================================
# Villa Box — Backend/API .env untuk PRODUKSI
# Subdomain API: be-bamboe.bamboeoerip.com
# Folder cPanel: /home/ckgiyjjt/be-bamboe  (document root -> public/)
# Salin ke ".env" di server, lalu jalankan: php artisan key:generate
# ============================================================

APP_NAME="Villa Box"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# Penting: dipakai untuk URL gambar (storage). Harus domain API.
APP_URL=https://be-bamboe.bamboeoerip.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Origin frontend utama (untuk CORS). Domain customer, staging, & admin
# (kelola) sudah ditambahkan permanen di config/cors.php.
FRONTEND_URL=https://bamboeoerip.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ckgiyjjt_bamboe
DB_USERNAME=ckgiyjjt_oerip
DB_PASSWORD="I!DEoEd*lfTqs-xB"

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@bamboeoerip.com"
MAIL_FROM_NAME="${APP_NAME}"
